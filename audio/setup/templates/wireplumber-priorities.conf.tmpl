wireplumber.settings = {
  linking.allow-moving-streams  = true
  linking.follow-default-target = true
}
{{if or .BTPriorities .DisabledBT}}
monitor.bluez.rules = [
{{- range .BTPriorities}}
  {
    matches = [{ node.name = "{{.Name}}" }]
    actions = { update-props = { priority.session = {{.Prio}} } }
  }
{{- end}}
{{- range .DisabledBT}}
  # device.disabled only exists on devices: a rule matching one of its nodes is
  # ignored, so a Bluetooth device is hidden whole (output and mic).
  {
    matches = [{ device.name = "{{.}}" }]
    actions = { update-props = { device.disabled = true } }
  }
{{- end}}
]
{{end}}
monitor.alsa.rules = [
  # Never suspend microphones: a USB mic woken up by a new recording crackles
  # for its first second or two while the ADC settles.
  {
    matches = [{ node.name = "~alsa_input.*" }]
    actions = { update-props = { session.suspend-timeout-seconds = 0 } }
  }
{{- range .ALSAPriorities}}
  {
    matches = [{ node.name = "{{.Name}}" }]
    actions = { update-props = { priority.session = {{.Prio}} } }
  }
{{- end}}
{{- range .DisabledCards}}
  {
    matches = [{ device.name = "{{.}}" }]
    actions = { update-props = { device.profile = "off" } }
  }
{{- end}}
]
