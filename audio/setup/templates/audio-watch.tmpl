#!/bin/bash
# audio-watch — generated by soundbar-setup (audio.sh); run by
# audio-watch.service. Follows the outputs as they come and go:
#  - hands the equalizer state to a device that has one when it connects (the
#    equalizer lives on the device node, and goes with it);
#  - plays the keepalive tone on the devices that asked for one, only while
#    they are connected (some speakers power off after minutes of silence),
#    and replays it whenever their volume moves (see start_tone);
#  - forgets a hand-picked default whenever a ranked output or microphone
#    appears or disappears, so the priority order picks again;
#  - keeps the highest ranked microphone that is connected as the default one,
#    at all times: a default picked by hand is put back at once (an app can
#    still record from another microphone chosen in its own settings).

export LC_ALL=C   # `pactl subscribe` is parsed below, and it is translated

EQ=(
{{- range .EQSinks}}
  "{{.}}"
{{- end}}
)
KEEPALIVE=(
{{- range .Keepalives}}
  "{{.Sink}}"
{{- end}}
)
# Each device's tone, as tuned in the wizard: frequency in Hz, ffmpeg volume.
declare -A hz vol
{{- range .Keepalives}}
hz["{{.Sink}}"]={{.Hz}} vol["{{.Sink}}"]={{.Volume}}
{{- end}}
RANKED=(
{{- range .RankedSinks}}
  "{{.}}"
{{- end}}
)
RANKED_MICS=(
{{- range .RankedSources}}
  "{{.}}"
{{- end}}
)

declare -A eq     # equalized devices there at the last pass
declare -A tone   # device -> pid of its tone (kept while the device is there)
declare -A node   # device -> node id its volume is read on
declare -A level  # device -> the volume its tone is sized for
present=unset     # ranked outputs and mics there at the last pass
settle=""         # set: a volume moved, the tones are replayed once it settles

alive() { [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null; }

# The volume applied to a node's samples (its louder channel); 1 when it can't
# be read, which boosts nothing.
soft_volume() {
  pw-cli enum-params "$1" Props 2>/dev/null | awk '
    /Props:softVolumes/ { in_soft = 1; next }
    in_soft && /Prop:/ { exit }
    in_soft && $1 == "Float" && $2 > loudest { loudest = $2 }
    END { print (loudest > 0 ? loudest : 1) }'
}

# The volume a device's tone is sized for: the one applied to its samples, no
# lower than where the boosted tone reaches full scale (ffmpeg's sine peaks at
# 1/8 of it).
tone_level() {
  awk -v soft="$(soft_volume "${node[$1]}")" -v v="${vol[$1]}" \
    'BEGIN { floor = v / 8; print (soft > floor ? soft : floor) }'
}

# Enough signal to keep the device awake, nothing to hear (18 kHz at 5% unless
# tuned) — at the device: most Bluetooth speakers leave their volume to the PC
# (no absolute volume), which scales every sample played there, the tone's
# too. At 19% a tone at 5% reached the soundbar at -90 dBFS and it fell
# asleep. So the tone is played louder by the inverse of that volume, but
# never past full scale before it: a volume raised in one go leaves the tone
# too strong until it is replayed, and a clipped tone can be heard. Below that
# point (about 18% for a tone at 5%) the tone weakens with the volume.
# Float: at its most boosted the sine peaks at exactly full scale, a step past
# what s16 holds. dont-reconnect, dont-move: the tone must never follow the
# streams to another output.
start_tone() {
  local gain
  node[$1]=$(pactl list sinks | awk -v s="$1" '
    $1 == "Name:" { on = ($2 == s) }
    on && $1 == "object.id" { gsub(/"/, "", $3); print $3; exit }')
  level[$1]=$(tone_level "$1")
  gain=$(awk -v v="${vol[$1]}" -v l="${level[$1]}" 'BEGIN { printf "%.6g", v / l }')
  pw-cat --playback --raw --format f32 --rate 44100 --channels 1 --target "$1" \
    -P '{ application.name = audio-keepalive node.name = audio-keepalive node.dont-reconnect = true node.dont-move = true }' - \
    < <(exec ffmpeg -nostdin -loglevel fatal \
          -f lavfi -i "sine=frequency=${hz[$1]}:sample_rate=44100" \
          -af "aformat=sample_fmts=flt,volume=$gain" -f f32le -) &
  tone[$1]=$!
}

# A volume moved (or anything else about an output). A tone now too strong
# stops at once; any tone sized for another volume is replayed once the
# volume has settled — a slider sends a change at every step.
volume_moved() {
  local sink now
  for sink in "${!tone[@]}"; do
    alive "${tone[$sink]}" || continue
    now=$(tone_level "$sink")
    [ "$now" = "${level[$sink]}" ] && continue
    if awk -v a="$now" -v b="${level[$sink]}" 'BEGIN { exit !(a > b) }'; then
      kill "${tone[$sink]}" 2>/dev/null
    fi
    settle=1
  done
}

reconcile() {
  local sinks sources sink now=""
  sinks=$(pactl list short sinks | awk '{print $2}') || return
  sources=$(pactl list short sources | awk '{print $2}') || return

  # Only a device that just appeared: setting the graph again on a playing one
  # reloads it.
  for sink in "${EQ[@]}"; do
    if ! grep -qxF -- "$sink" <<<"$sinks"; then
      unset "eq[$sink]"
    elif [ -z "${eq[$sink]:-}" ]; then
      if {{.ScriptsDir}}/audio-eq apply "$sink" >/dev/null; then
        eq[$sink]=1
        echo "equalizer state applied on $sink"
      fi
    fi
  done

  for sink in "${KEEPALIVE[@]}"; do
    if grep -qxF -- "$sink" <<<"$sinks"; then
      if [ -z "${tone[$sink]:-}" ]; then
        start_tone "$sink"
        echo "keepalive on $sink"
      elif ! alive "${tone[$sink]}"; then
        start_tone "$sink"   # stopped for a louder volume, or died
      elif [ "$(tone_level "$sink")" != "${level[$sink]}" ]; then
        kill "${tone[$sink]}" 2>/dev/null   # sized for a volume that has moved
        start_tone "$sink"
      fi
    elif [ -n "${tone[$sink]:-}" ]; then
      kill "${tone[$sink]}" 2>/dev/null
      unset "tone[$sink]" "node[$sink]" "level[$sink]"
      echo "keepalive off $sink"
    fi
  done

  for sink in "${RANKED[@]}"; do
    grep -qxF -- "$sink" <<<"$sinks" && now+="$sink "
  done
  for sink in "${RANKED_MICS[@]}"; do
    grep -qxF -- "$sink" <<<"$sources" && now+="$sink "
  done
  if [ "$now" != "$present" ]; then
    wpctl clear-default
    present=$now
  fi

  # RANKED_MICS is in priority order: the first one there is the default.
  for sink in "${RANKED_MICS[@]}"; do
    grep -qxF -- "$sink" <<<"$sources" || continue
    if [ "$(pactl get-default-source)" != "$sink" ]; then
      pactl set-default-source "$sink" && echo "default microphone: $sink"
    fi
    break
  done
}

# Stopping the service must not leave a tone behind.
trap 'kill "${tone[@]}" "$events" 2>/dev/null' EXIT
trap 'exit 0' TERM INT

exec 3< <(exec pactl subscribe)
events=$!
reconcile
while :; do
  wait_for=30
  [ -z "$settle" ] || wait_for=0.5
  read -r -t "$wait_for" -u 3 line
  rc=$?
  if [ "$rc" -gt 128 ]; then
    # Nothing for a while: a moved volume has settled, or it's the 30 s safety
    # pass, which restarts what died.
    settle=""
    reconcile
    continue
  fi
  [ "$rc" -eq 0 ] || break   # event stream closed: pipewire-pulse went away
  case $line in
    *"'new' on sink #"*|*"'remove' on sink #"*) reconcile ;;
    *"'new' on source #"*|*"'remove' on source #"*) reconcile ;;
    *"'change' on server"*) reconcile ;;   # the default was changed
    *"'change' on sink #"*) volume_moved ;;
  esac
done

exit 1
