# Generated by soundbar-setup (audio.sh) — re-running it replaces this file.
# Correction EQs: each graph is set on the device node itself, so it applies to
# everything played there and adds no output of its own.
node.filter-graph.rules = [
{{- range .}}
  # {{.Desc}}: {{.Name}}{{if .Source}} ({{.Source}}){{end}}
  {
    matches = [{ {{.Match}} }]
    actions = {
      create-filter-graph = [
        {{.Graph}}
      ]
    }
  }
{{- end}}
]
