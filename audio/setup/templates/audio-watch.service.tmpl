[Unit]
Description=Audio outputs watcher (keepalive tone, priority order)
# Generated by soundbar-setup (audio.sh). Wants, not Requires: when
# pipewire-pulse restarts the script loses its event stream, exits, and
# Restart= brings it back.
After=pipewire-pulse.service wireplumber.service
Wants=pipewire-pulse.service

[Service]
ExecStart={{.ScriptsDir}}/audio-watch
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
