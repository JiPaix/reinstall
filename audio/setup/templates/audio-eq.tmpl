#!/bin/bash
# audio-eq — generated by soundbar-setup (audio.sh).
#   audio-eq on|off    switch the equalizer of every output that has one
#   audio-eq status    print the current state
#   audio-eq apply [output…]   set the saved state again, on these outputs or
#                      on all (audio-watch, when a device connects)
# All of them print the state as JSON: { "eq": true|false }
#
# The equalizer is a filter graph on the device node itself: "on" sets it,
# "off" clears it. Nothing is relinked, and the swapped channels (another graph
# of the same node) stay swapped. A device that isn't connected gets the saved
# state from audio-watch when it appears.

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/soundbar-setup/eq"
OUTPUTS=(
{{- range .EQSinks}}
  "{{.}}"
{{- end}}
)
ON='{{.EQParamsOn}}'
OFF='{{.EQParamsOff}}'

saved() { [ "$(cat "$STATE" 2>/dev/null)" = off ] && echo off || echo on; }

apply() {
  local nodes name id params=$ON
  [ "$(saved)" = off ] && params=$OFF
  [ $# -gt 0 ] || set -- "${OUTPUTS[@]}"
  nodes=$(pw-cli ls Node 2>/dev/null) || return 1
  for name; do
    id=$(awk -v name="\"$name\"" '
      $1 == "id" { id = $2; sub(",", "", id) }
      $1 == "node.name" && $3 == name { print id; exit }' <<<"$nodes")
    [ -n "$id" ] || continue   # its device isn't connected
    pw-cli set-param "$id" Props "$params" >/dev/null || return 1
  done
}

report() {
  if [ ${#OUTPUTS[@]} -gt 0 ] && [ "$(saved)" = on ]; then
    echo '{ "eq": true }'
  else
    echo '{ "eq": false }'
  fi
}

case "${1:-}" in
  on|off)
    if [ ${#OUTPUTS[@]} -eq 0 ]; then
      echo "no output was set up with an equalizer" >&2
      exit 1
    fi
    mkdir -p "$(dirname "$STATE")" && echo "$1" > "$STATE" || exit 1
    apply || { echo "could not reach PipeWire; the equalizer switches $1 once it is back" >&2; exit 1; }
    report ;;
  apply)  shift; apply "$@"; report ;;
  status) report ;;
  *) echo "usage: audio-eq on|off|status|apply [output…]" >&2; exit 2 ;;
esac
