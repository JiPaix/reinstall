# Generated by soundbar-setup (audio.sh) — re-running it replaces this file.
# "{{.Desc}}": an output of its own, in front of {{.Target}}.
# Run as a separate PipeWire client by audio-watch, only while that device is
# connected: loaded from pipewire.conf.d the output would exist all the time,
# and stay selected after its device is gone.
context.properties = {
    log.level = 0
}
context.spa-libs = {
    audio.convert.* = audioconvert/libspa-audioconvert
    support.*       = support/libspa-support
}
context.modules = [
    { name = libpipewire-module-rt
        args = { }
        flags = [ ifexists nofail ]
    }
    { name = libpipewire-module-protocol-native }
    { name = libpipewire-module-client-node }
    { name = libpipewire-module-adapter }
  { name = libpipewire-module-filter-chain
    args = {
      node.description = "{{.Desc}}"
      filter.graph = {
        nodes = [
{{- if .EQ}}
{{- $f := .}}
{{- range $side := .Sides}}
          { type   = ladspa
            name   = {{$side}}
            plugin = {{$f.MbeqPath}}
            label  = mbeq
            control = {
{{- range $f.Bands}}
              "{{.Label}}" = {{.Gain}}
{{- end}}
            }
          }
{{- end}}
{{- else}}
{{- range .Sides}}
          { type = builtin name = {{.}} label = copy }
{{- end}}
{{- end}}
        ]
        inputs  = [ {{.Inputs}} ]
        outputs = [ {{.Outputs}} ]
      }
      capture.props = {
        node.name        = "{{.Name}}"
        media.class      = Audio/Sink
        audio.channels   = 2
        audio.position   = [ FL FR ]
        priority.session = {{.Prio}}
      }
      # dont-fallback/dont-reconnect: when the device goes, nothing of this
      # output may land on another one, not even until audio-watch stops it.
      playback.props = {
        node.name           = "{{.Name}}.out"
        audio.channels      = 2
        audio.position      = [ FL FR ]
        target.object       = "{{.Target}}"
        stream.dont-remix   = true
        node.passive        = true
        node.dont-fallback  = true
        node.dont-reconnect = true
      }
    }
  }
]
