# Generated by soundbar-setup (audio.sh) — re-running it replaces this file.
# Graphs set on the device nodes themselves: they apply to everything played
# there and add no output of their own.
node.filter-graph.rules = [
{{- range .}}
  # {{.Desc}}
  {
    matches = [{ {{.Match}} }]
    actions = {
      create-filter-graph = [
{{- $r := .}}
{{- range $i, $g := .Graphs}}
        # {{index $r.Notes $i}}
        {{$g}}
{{- end}}
      ]
    }
  }
{{- end}}
]
